# Variables de entorno del backend. Copia este fichero, rellena los valores y cárgalos en tu entorno
# (o en el panel de tu proveedor). No subas nunca un fichero con valores reales al repositorio.

# --- Base de datos (obligatorias) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/bidco
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# --- Seguridad (obligatoria) ---
# Al menos 32 bytes. Genera uno nuevo por entorno: openssl rand -base64 48
JWT_SECRET=

# --- Imágenes: Cloudinary (obligatorias para subir imágenes) ---
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Opcionales (valores por defecto entre paréntesis) ---
# JWT_EXPIRATION_MS=86400000
# DDL_AUTO=update                 (en producción: validate)
# APP_TIMEZONE=Europe/Madrid
# CORS_ALLOWED_ORIGINS=http://localhost:4200,https://bid-co.vercel.app
# CORS_ALLOWED_ORIGIN_PATTERNS=https://bid-co-*.vercel.app
# CLOUDINARY_CLOUD_NAME=dwgi3kagx (nombre de la nube de Cloudinary)
# SWAGGER_ENABLED=false
# CIERRE_ACTIVO=true               (cierre programado de subastas y sorteos vencidos)
# CIERRE_INTERVALO_MS=60000
# CIERRE_RETRASO_INICIAL_MS=30000
# ANTISNIPING_MINUTOS=5            (una puja líder en los últimos minutos retrasa el cierre; 0 lo desactiva)
# RATE_LIMIT_ENABLED=true          (límite de peticiones por IP)
# RATE_LIMIT_GENERAL_PER_MINUTE=300
# Solo en local, sin HTTPS:
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAME_SITE=lax

# --- Recuperación de contraseña por correo: Brevo (si faltan, la función se desactiva) ---
# BREVO_API_KEY=
# MAIL_FROM=
# MAIL_FROM_NAME=BidCo
# FRONTEND_URL=https://bid-co.vercel.app

# --- Docker Compose (solo entorno local; ver docker-compose.yml) ---
# POSTGRES_PASSWORD=       # elige una contraseña para la base de datos local
# JWT_SECRET (arriba) también es obligatorio con docker compose
